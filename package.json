{
  "name": "towerriot",
  "version": "0.1.0",
  "private": true,
  "description": "TowerRiot: a tower defence game for web, mobile web, iOS and Android (both native). Plays fully offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gen-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:arch": "vitest run tests/invariants.test.ts tests/stages.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "native:data": "UPDATE_NATIVE_DATA=1 vitest run tests/native-data.test.ts",
    "native:art": "node scripts/bake-ios-art.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
