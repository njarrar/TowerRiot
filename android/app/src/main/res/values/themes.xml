<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Morning paper behind everything, so there is no dark flash while the app starts. -->
    <style name="Theme.TowerRiot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
